/// An atomic sequential counter that auto-generates values on entity creation
[Id("e1d76d57-bb9e-4df2-b78f-5395f725a8e4")]
sealed entity Counter {
  /// Unique name identifying this counter
  [Id("1a4c58db-b1da-408f-aa8d-2d22948c7cde"), MaxLength(100)] string Name;
  /// Optional scope reference in EntityName.PropertyName format for per-parent sequencing
  [Id("f125915a-6a79-4f34-bad1-6ef2d71acde4"), MaxLength(500)] string? Scope;
  /// Format string for Formatted counters using {0} placeholder
  [Id("87d91419-8030-4aff-a707-d650b197f4bd"), MaxLength(500)] string? Template;
  /// The initial value the counter starts from
  [Id("f5374d60-5ad9-451a-af01-be69354d167b")] long StartValue;
  /// Counter output type: Integer or Formatted
  [Id("001a6fc6-e9c0-4975-958f-f5b0bedfaafb"), MaxLength(20)] string CounterType;
  /// The step size for each counter increment
  [Id("9ec9dddf-a226-4b46-a536-004be4b29c9d")] int Increment;
  /// The last value generated by this counter
  [Id("1459fc30-62c3-4dd0-961b-1983e5475fe2")] long CurrentValue;
  /// The bare source-module filename this counter's `Counter Name = new()` value declaration was in (`ModuleName.osy`),
  /// stamped at compile so the full-app export regenerates it into its own module file. Mirrors EntityMetadata.SourceFile.
  [Id("d13ac1f9-8d9c-4c54-93cf-0679950c65d2")] string? SourceFile;
}
