/// A named secret (API key, OAuth token, etc.) stored encrypted in the metadata database
[Id("fcff0d0a-e498-4f6d-bf92-cf6bd522da7b")]
sealed entity SecretDefinition {
  /// For user-scoped secrets: the owning user's ID. Null for app-scoped secrets.
  [Id("9f34e859-e580-4a58-a833-07e741f92681")] Guid UserId;
  /// The encrypted secret value — never exposed through the API
  [Id("b650fa59-a71b-458e-b576-da290847af34")] string? EncryptedValue;
  /// Unique secret name (PascalCase, no spaces)
  [Id("05335390-e176-4a21-ab46-d187e8cc36b6"), MaxLength(255)] string Name;
  /// Secret scope: 0=App (shared), 1=User (per-user)
  [Id("099041ad-1599-4c7a-9366-422c7426e8e8")] int Scope;
}
